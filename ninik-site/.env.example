# npm run preview enables sandbox-only sample orders and a test admin login.
# For a live shop, provision PostgreSQL and set these values in the host's secret settings.
DATABASE_URL=
NINIK_ADMIN_PASSWORD=
NINIK_SESSION_SECRET=
NINIK_ENABLE_ORDERS=0

# Set only after the real catalogue, business info, and public HTTPS host are ready.
SITE_URL=
GOOGLE_SITE_VERIFICATION=

# Optional persistent directory for self-hosted Node (not usable on Vercel).
# NINIK_DATA_DIR=/path/to/persistent-volume

# Public Vercel preview: safe browser-local data only; no database/API writes.
# NINIK_BROWSER_DEMO=1

# GROK DESK runs fully in paper mode with no keys. These are only read if you
# want RESEARCH to score narratives with a real model instead of the offline
# heuristic. Copy to .env and fill in.

# XAI_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE=https://api.x.ai/v1

# --- GROK SCALP (optional) -------------------------------------------------
# Any OpenAI-compatible vision model, for reading chart screenshots properly.
# Without a key the engine uses the offline "vision-lite" reader (Pillow).
# VISION_API_KEY=
# VISION_BASE=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini

# CryptoPanic headlines. Without it, news tone is neutral.
# CRYPTOPANIC_TOKEN=
